#!/bin/bash

# ============================================================
#                    DRACO V4 INSTALLER
#                     SUPRIAL HOSTING
# ============================================================

set -Eeuo pipefail

# ============================================================
# COLORS
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m'

# ============================================================
# CONFIG
# ============================================================

REPO_URL="https://github.com/dragonlabsdev/v3panel"

# Main installation folder
INSTALL_DIR="/opt/draco"

# Repository folder
REPO_DIR="${INSTALL_DIR}/v3panel"

# Default PM2 name
DEFAULT_PM2_NAME="draco-panel"

NODE_MAJOR="23"

# ============================================================
# ASCII
# ============================================================

ASCII_ART='
██████╗ ██████╗  █████╗  ██████╗ ██████╗
██╔══██╗██╔══██╗██╔══██╗██╔════╝██╔═══██╗
██║  ██║██████╔╝███████║██║     ██║   ██║
██║  ██║██╔══██╗██╔══██║██║     ██║   ██║
██████╔╝██║  ██║██║  ██║╚██████╗╚██████╔╝
╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝

              DRACO V4 INSTALLER
'

# ============================================================
# FUNCTIONS
# ============================================================

info() {
    echo -e "${CYAN}[INFO]${NC} $1"
}

success() {
    echo -e "${GREEN}[✓]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[!]${NC} $1"
}

error() {
    echo -e "${RED}[✗]${NC} $1"
}

section() {
    echo ""
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BOLD}${MAGENTA}  $1${NC}"
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

fail() {
    error "$1"
    exit 1
}

pause_screen() {
    echo ""
    read -rp "$(echo -e "${GRAY}Press ENTER to continue...${NC}")"
}

# ============================================================
# ERROR HANDLER
# ============================================================

trap '
echo ""
echo -e "${RED}[✗] Installer stopped at line ${LINENO}.${NC}"
echo ""
echo -e "${YELLOW}Try:${NC}"
echo "  pm2 logs ${PM2_NAME:-draco-panel}"
echo ""
' ERR

# ============================================================
# START
# ============================================================

clear

echo -e "${CYAN}${ASCII_ART}${NC}"
echo ""
echo -e "${BOLD}${WHITE}             DRACO V4 PANEL INSTALLER${NC}"
echo -e "${CYAN}                 SUPRIAL HOSTING${NC}"
echo ""

# ============================================================
# ROOT
# ============================================================

section "ROOT ACCESS"

if [ "$EUID" -ne 0 ]; then
    fail "Please run this installer as root."
fi

success "Root access confirmed."

# ============================================================
# PM2 NAME
# ============================================================

section "PM2 CONFIGURATION"

echo ""
echo -e "${WHITE}Choose a PM2 process name.${NC}"
echo -e "${GRAY}Press ENTER for: ${DEFAULT_PM2_NAME}${NC}"
echo ""

read -rp "$(echo -e "${YELLOW}PM2 Name: ${NC}")" PM2_NAME

PM2_NAME="${PM2_NAME:-$DEFAULT_PM2_NAME}"

if [[ ! "$PM2_NAME" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    fail "Invalid PM2 name."
fi

success "PM2 process: ${PM2_NAME}"

# ============================================================
# SYSTEM PREPARATION
# ============================================================

section "SYSTEM PREPARATION"

export DEBIAN_FRONTEND=noninteractive

info "Updating package lists..."

apt-get update -y

info "Installing dependencies..."

apt-get install -y \
    curl \
    git \
    ca-certificates \
    gnupg \
    unzip \
    zip \
    build-essential \
    python3 \
    make \
    g++

success "System dependencies installed."

# ============================================================
# NODE.JS
# ============================================================

section "NODE.JS ${NODE_MAJOR}"

CURRENT_NODE=""

if command -v node >/dev/null 2>&1; then
    CURRENT_NODE="$(node -v | sed 's/^v//' | cut -d. -f1)"
fi

if [ "$CURRENT_NODE" != "$NODE_MAJOR" ]; then

    info "Installing Node.js ${NODE_MAJOR}..."

    curl -fsSL \
        "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" |
        bash -

    apt-get install -y nodejs

else

    success "Node.js ${NODE_MAJOR} already installed."

fi

echo ""
echo -e "${GREEN}Node.js:${NC} $(node -v)"
echo -e "${GREEN}NPM:${NC}     $(npm -v)"

# ============================================================
# CREATE INSTALLATION FOLDER
# ============================================================

section "CREATING DRACO DIRECTORY"

mkdir -p "$INSTALL_DIR"

success "Installation directory created:"
echo "  $INSTALL_DIR"

# ============================================================
# ENTER INSTALLATION FOLDER
# ============================================================

section "ENTERING INSTALLATION DIRECTORY"

cd "$INSTALL_DIR"

success "Current directory:"
pwd

# ============================================================
# OLD INSTALLATION
# ============================================================

if [ -d "$REPO_DIR" ]; then

    BACKUP_DIR="${INSTALL_DIR}/backup-$(date +%Y%m%d-%H%M%S)"

    warning "Previous Draco installation detected."

    mkdir -p "$BACKUP_DIR"

    mv "$REPO_DIR" "$BACKUP_DIR/"

    success "Previous installation backed up:"
    echo "  $BACKUP_DIR"

fi

# ============================================================
# CLONE
# ============================================================

section "CLONING DRACO PANEL"

info "Repository:"
echo "  $REPO_URL"
echo ""

git clone "$REPO_URL" "$REPO_DIR"

success "Repository cloned."

# ============================================================
# ENTER REPOSITORY
# ============================================================

section "ENTERING REPOSITORY"

cd "$REPO_DIR"

success "Current directory:"
pwd

# ============================================================
# SHOW REPOSITORY
# ============================================================

section "REPOSITORY CONTENTS"

echo ""

ls -lah

echo ""

# ============================================================
# FIND PANEL ZIP
# ============================================================

section "SEARCHING FOR PANEL PACKAGE"

PANEL_ZIP=""

if [ -f "$REPO_DIR/panel.zip" ]; then

    PANEL_ZIP="$REPO_DIR/panel.zip"

else

    PANEL_ZIP="$(
        find "$REPO_DIR" \
            -maxdepth 3 \
            -type f \
            -iname "panel.zip" |
        head -n 1 ||
        true
    )"

fi

if [ -z "$PANEL_ZIP" ]; then

    error "panel.zip was not found."

    echo ""
    echo -e "${YELLOW}Files found in repository:${NC}"
    find "$REPO_DIR" -maxdepth 3 -type f | head -100

    echo ""

    fail "Cannot continue without panel.zip."

fi

success "panel.zip found:"
echo "  $PANEL_ZIP"

# ============================================================
# EXTRACT PANEL
# ============================================================

section "EXTRACTING PANEL"

EXTRACT_DIR="${REPO_DIR}/panel"

mkdir -p "$EXTRACT_DIR"

info "Extracting package..."

unzip -o "$PANEL_ZIP" -d "$EXTRACT_DIR"

success "Panel package extracted."

# ============================================================
# FIND REAL PANEL DIRECTORY
# ============================================================

section "LOCATING PANEL DIRECTORY"

PANEL_PATH=""

# First check directly
if [ -f "$EXTRACT_DIR/package.json" ]; then

    PANEL_PATH="$EXTRACT_DIR"

else

    # Search for package.json
    PACKAGE_FILE="$(
        find "$EXTRACT_DIR" \
            -type f \
            -name "package.json" |
        head -n 1 ||
        true
    )"

    if [ -n "$PACKAGE_FILE" ]; then
        PANEL_PATH="$(dirname "$PACKAGE_FILE")"
    fi

fi

# ============================================================
# SECONDARY SEARCH
# ============================================================

if [ -z "$PANEL_PATH" ]; then

    warning "Panel package.json not found in first location."

    PACKAGE_FILE="$(
        find "$REPO_DIR" \
            -type f \
            -name "package.json" |
        head -n 1 ||
        true
    )"

    if [ -n "$PACKAGE_FILE" ]; then
        PANEL_PATH="$(dirname "$PACKAGE_FILE")"
    fi

fi

# ============================================================
# FINAL CHECK
# ============================================================

if [ -z "$PANEL_PATH" ] || [ ! -f "$PANEL_PATH/package.json" ]; then

    error "Could not locate the actual panel directory."

    echo ""
    echo -e "${YELLOW}Detected package.json files:${NC}"

    find "$REPO_DIR" \
        -type f \
        -name "package.json" \
        -print || true

    echo ""

    echo -e "${YELLOW}Extracted structure:${NC}"

    find "$EXTRACT_DIR" \
        -maxdepth 3 \
        -print | head -150 || true

    echo ""

    fail "Panel directory could not be detected."

fi

success "Panel directory detected:"
echo "  $PANEL_PATH"

# ============================================================
# ENTER PANEL
# ============================================================

section "ENTERING PANEL"

cd "$PANEL_PATH"

success "Current directory:"
pwd

# ============================================================
# PACKAGE CHECK
# ============================================================

section "VERIFYING PANEL"

if [ ! -f "package.json" ]; then
    fail "package.json is missing."
fi

success "package.json found."

# ============================================================
# NPM INSTALL
# ============================================================

section "INSTALLING NPM PACKAGES"

info "Running npm install..."

npm install

success "NPM packages installed."

# ============================================================
# DATABASE
# ============================================================

section "DATABASE SETUP"

if npm run | grep -q "seed"; then

    info "Running database seed..."

    npm run seed

    success "Database seeded."

else

    warning "npm seed script not found."
    warning "Skipping database seed."

fi

# ============================================================
# CREATE USER
# ============================================================

section "PANEL USER"

echo ""
echo -e "${YELLOW}Panel user creation wizard will start now.${NC}"
echo -e "${GRAY}Enter your administrator account details when asked.${NC}"
echo ""

if npm run | grep -q "createUser"; then

    npm run createUser

    success "Panel user created."

else

    warning "createUser script not found."
    warning "Skipping user creation."

fi

# ============================================================
# PM2
# ============================================================

section "INSTALLING PM2"

if command -v pm2 >/dev/null 2>&1; then

    success "PM2 already installed."

else

    info "Installing PM2..."

    npm install pm2@latest -g

    success "PM2 installed."

fi

# ============================================================
# STOP OLD PROCESS
# ============================================================

section "PREPARING PM2"

pm2 delete "$PM2_NAME" 2>/dev/null || true

success "Old PM2 process cleared."

# ============================================================
# START PANEL
# ============================================================

section "STARTING DRACO PANEL"

if [ -f "index.js" ]; then

    info "Detected index.js."

    pm2 start index.js \
        --name "$PM2_NAME"

elif npm run | grep -q "start"; then

    info "Using npm start."

    pm2 start npm \
        --name "$PM2_NAME" \
        -- start

else

    fail "Could not determine how to start the panel."

fi

success "Draco panel started."

# ============================================================
# SAVE PM2
# ============================================================

section "SAVING PM2"

pm2 save

success "PM2 process saved."

# ============================================================
# PM2 STARTUP
# ============================================================

section "CONFIGURING AUTO START"

if command -v systemctl >/dev/null 2>&1 &&
   [ -d "/run/systemd/system" ]; then

    info "Systemd detected."

    pm2 startup systemd \
        -u root \
        --hp /root || true

    pm2 save

    success "PM2 auto-start configured."

else

    warning "Systemd is not available on this VPS."
    warning "PM2 auto-start was skipped."

fi

# ============================================================
# WAIT
# ============================================================

section "WAITING FOR PANEL"

info "Giving Draco a few seconds to start..."

sleep 5

# ============================================================
# STATUS
# ============================================================

section "PM2 STATUS"

pm2 status

# ============================================================
# PROCESS CHECK
# ============================================================

section "PROCESS CHECK"

PM2_PID="$(pm2 pid "$PM2_NAME" 2>/dev/null || true)"

if [[ "$PM2_PID" =~ ^[0-9]+$ ]] && [ "$PM2_PID" -gt 0 ]; then

    success "Draco is running."
    echo -e "${GREEN}PID:${NC} $PM2_PID"

else

    warning "Draco process may not be running."

    echo ""
    echo -e "${YELLOW}Latest logs:${NC}"

    pm2 logs "$PM2_NAME" \
        --lines 20 \
        --nostream || true

fi

# ============================================================
# FINAL
# ============================================================

echo ""

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}${GREEN}                DRACO V4 READY ✓${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

echo ""

echo -e "${CYAN}Main Folder:${NC}"
echo "  $INSTALL_DIR"

echo ""

echo -e "${CYAN}Repository:${NC}"
echo "  $REPO_DIR"

echo ""

echo -e "${CYAN}Panel Directory:${NC}"
echo "  $PANEL_PATH"

echo ""

echo -e "${CYAN}PM2 Process:${NC}"
echo "  $PM2_NAME"

echo ""

echo -e "${YELLOW}Useful Commands:${NC}"
echo ""
echo "  pm2 status"
echo "  pm2 logs $PM2_NAME"
echo "  pm2 restart $PM2_NAME"
echo "  pm2 stop $PM2_NAME"
echo "  pm2 save"

echo ""

echo -e "${GREEN}✓ Draco installation completed.${NC}"
echo ""
