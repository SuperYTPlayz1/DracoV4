#!/bin/bash

# ============================================================
#                    DRACO V4 INSTALLER
# ============================================================

set -Eeuo pipefail

# ============================================================
# COLORS
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m'

# ============================================================
# CONFIG
# ============================================================

REPO_URL="https://github.com/dragonlabsdev/v3panel"
INSTALL_DIR="/opt/draco-panel"
NODE_MAJOR="23"

# ============================================================
# ASCII
# ============================================================

ASCII_ART='
██████╗ ██████╗  █████╗  ██████╗ ██████╗
██╔══██╗██╔══██╗██╔══██╗██╔════╝██╔═══██╗
██║  ██║██████╔╝███████║██║     ██║   ██║
██║  ██║██╔══██╗██╔══██║██║     ██║   ██║
██████╔╝██║  ██║██║  ██║╚██████╗╚██████╔╝
╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝

              DRACO V4 INSTALLER
'

# ============================================================
# FUNCTIONS
# ============================================================

info() {
    echo -e "${CYAN}[INFO]${NC} $1"
}

success() {
    echo -e "${GREEN}[✓]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[!]${NC} $1"
}

error() {
    echo -e "${RED}[✗]${NC} $1"
}

section() {
    echo ""
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BOLD}${MAGENTA}  $1${NC}"
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

fail() {
    error "$1"
    exit 1
}

# ============================================================
# ERROR HANDLER
# ============================================================

trap '
echo ""
echo -e "${RED}[✗] Installer stopped at line ${LINENO}.${NC}"
' ERR

# ============================================================
# START
# ============================================================

clear

echo -e "${CYAN}${ASCII_ART}${NC}"
echo ""
echo -e "${BOLD}${WHITE}          DRACO V4 PANEL INSTALLER${NC}"
echo -e "${CYAN}             SUPRIAL HOSTING${NC}"
echo ""

# ============================================================
# ROOT CHECK
# ============================================================

section "ROOT ACCESS"

if [ "$EUID" -ne 0 ]; then
    fail "Run this installer as root."
fi

success "Root access confirmed."

# ============================================================
# PM2 NAME
# ============================================================

section "PM2 CONFIGURATION"

echo ""
echo -e "${WHITE}Choose a name for the PM2 process.${NC}"
echo ""
echo -e "${GRAY}Example: draco-panel${NC}"
echo ""

while true; do

    read -rp "$(echo -e "${YELLOW}PM2 name: ${NC}")" PM2_NAME

    PM2_NAME="$(echo "$PM2_NAME" | xargs)"

    if [[ "$PM2_NAME" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        break
    fi

    error "Invalid PM2 name."

done

success "PM2 name: ${PM2_NAME}"

# ============================================================
# SYSTEM
# ============================================================

section "SYSTEM PREPARATION"

export DEBIAN_FRONTEND=noninteractive

apt-get update -y

apt-get install -y \
    curl \
    git \
    ca-certificates \
    gnupg \
    unzip \
    zip \
    build-essential \
    python3 \
    make \
    g++

success "Dependencies installed."

# ============================================================
# NODE.JS
# ============================================================

section "NODE.JS ${NODE_MAJOR}"

CURRENT_NODE=""

if command -v node >/dev/null 2>&1; then
    CURRENT_NODE="$(node -v | sed 's/^v//' | cut -d. -f1)"
fi

if [ "$CURRENT_NODE" != "$NODE_MAJOR" ]; then

    info "Installing Node.js ${NODE_MAJOR}..."

    curl -fsSL \
        "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" |
        bash -

    apt-get install -y nodejs

else

    success "Node.js ${NODE_MAJOR} already installed."

fi

echo ""
echo "Node.js: $(node -v)"
echo "NPM:     $(npm -v)"

# ============================================================
# INSTALL DIRECTORY
# ============================================================

section "PREPARING PANEL"

mkdir -p /opt

if [ -d "$INSTALL_DIR" ]; then

    BACKUP_DIR="/opt/draco-panel-backup-$(date +%Y%m%d-%H%M%S)"

    warning "Existing panel found."
    info "Backing it up to:"
    echo "$BACKUP_DIR"

    mv "$INSTALL_DIR" "$BACKUP_DIR"

    success "Backup created."

fi

# ============================================================
# CLONE
# ============================================================

section "CLONING DRACO"

git clone "$REPO_URL" "$INSTALL_DIR"

cd "$INSTALL_DIR"

success "Repository cloned."

# ============================================================
# PANEL ZIP
# ============================================================

section "PANEL PACKAGE"

if [ ! -f "panel.zip" ]; then
    fail "panel.zip not found."
fi

success "panel.zip found."

info "Extracting panel.zip..."

unzip -o panel.zip

success "Panel extracted."

# ============================================================
# PANEL DIRECTORY
# ============================================================

if [ -d "$INSTALL_DIR/panel" ]; then

    PANEL_PATH="$INSTALL_DIR/panel"

else

    PANEL_PATH="$(
        find "$INSTALL_DIR" \
        -maxdepth 3 \
        -type d \
        -name panel |
        head -n 1 ||
        true
    )"

fi

if [ -z "$PANEL_PATH" ] || [ ! -d "$PANEL_PATH" ]; then
    fail "Panel directory not found."
fi

cd "$PANEL_PATH"

success "Panel directory:"
echo "$PANEL_PATH"

# ============================================================
# PACKAGE.JSON
# ============================================================

section "VERIFYING PANEL"

if [ ! -f "package.json" ]; then
    fail "package.json not found."
fi

success "package.json found."

# ============================================================
# NPM
# ============================================================

section "NPM INSTALL"

npm install

success "NPM packages installed."

# ============================================================
# DATABASE
# ============================================================

section "DATABASE"

npm run seed

success "Database seeded."

# ============================================================
# USER
# ============================================================

section "CREATE PANEL USER"

echo ""
echo -e "${YELLOW}Panel user creation wizard will start now.${NC}"
echo ""

npm run createUser

success "Panel user created."

# ============================================================
# PM2
# ============================================================

section "INSTALLING PM2"

if command -v pm2 >/dev/null 2>&1; then

    success "PM2 already installed."

else

    npm install pm2@latest -g

    success "PM2 installed."

fi

# ============================================================
# START
# ============================================================

section "STARTING DRACO"

pm2 delete "$PM2_NAME" 2>/dev/null || true

if [ -f "index.js" ]; then

    pm2 start index.js --name "$PM2_NAME"

else

    pm2 start npm --name "$PM2_NAME" -- start

fi

success "Draco panel started."

# ============================================================
# SAVE
# ============================================================

section "SAVING PM2"

pm2 save

success "PM2 process saved."

# ============================================================
# AUTO START
# ============================================================

section "PM2 AUTO START"

if command -v systemctl >/dev/null 2>&1 &&
   [ -d /run/systemd/system ]; then

    info "Systemd detected."

    pm2 startup systemd -u root --hp /root || true

    pm2 save

    success "PM2 auto-start configured."

else

    warning "Systemd is not available."
    warning "PM2 auto-start skipped."

fi

# ============================================================
# VERIFY
# ============================================================

section "VERIFYING PANEL"

sleep 5

pm2 status

echo ""

if pm2 pid "$PM2_NAME" 2>/dev/null | grep -qE '^[1-9][0-9]*$'; then

    success "Draco panel is running."

else

    error "Draco panel is not running."

    echo ""
    echo "Check logs:"
    echo "pm2 logs $PM2_NAME"

fi

# ============================================================
# FINAL
# ============================================================

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}${GREEN}               DRACO V4 READY ✓${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

echo -e "${CYAN}Panel Directory:${NC}"
echo "$PANEL_PATH"

echo ""

echo -e "${CYAN}PM2 Name:${NC}"
echo "$PM2_NAME"

echo ""

echo -e "${YELLOW}Useful Commands:${NC}"
echo ""
echo "pm2 status"
echo "pm2 logs $PM2_NAME"
echo "pm2 restart $PM2_NAME"
echo "pm2 stop $PM2_NAME"
echo "pm2 save"

echo ""
echo -e "${GREEN}Installation completed successfully.${NC}"
echo ""
