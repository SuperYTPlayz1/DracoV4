#!/bin/bash

# ============================================================
#                    DRACO V4 INSTALLER
#                  SUPRIAL HOSTING MAKER
# ============================================================

set -Eeuo pipefail

# ============================================================
# COLORS
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
BOLD='\033[1m'
NC='\033[0m'

# ============================================================
# CONFIG
# ============================================================

REPO_URL="https://github.com/dragonlabsdev/v3panel"
INSTALL_DIR="/opt/draco-panel"
NODE_MAJOR="23"

# ============================================================
# ASCII
# ============================================================

ASCII_ART='
██████╗ ██████╗  █████╗  ██████╗ ██████╗
██╔══██╗██╔══██╗██╔══██╗██╔════╝██╔═══██╗
██║  ██║██████╔╝███████║██║     ██║   ██║
██║  ██║██╔══██╗██╔══██║██║     ██║   ██║
██████╔╝██║  ██║██║  ██║╚██████╗╚██████╔╝
╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝

              DRACO V4 INSTALLER
             SUPRIAL HOSTING MAKER
'

# ============================================================
# FUNCTIONS
# ============================================================

info() {
    echo -e "${CYAN}[INFO]${NC} $1"
}

success() {
    echo -e "${GREEN}[✓]${NC} $1"
}

warning() {
    echo -e "${YELLOW}[!]${NC} $1"
}

error() {
    echo -e "${RED}[✗]${NC} $1"
}

section() {
    echo ""
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BOLD}${MAGENTA}  $1${NC}"
    echo -e "${MAGENTA}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

fail() {
    error "$1"
    echo ""
    error "Installer stopped."
    exit 1
}

pause_screen() {
    echo ""
    read -rp "$(echo -e "${GRAY}Press ENTER to continue...${NC}")"
}

# ============================================================
# ERROR HANDLER
# ============================================================

trap '
echo ""
echo -e "${RED}[✗] Installer stopped at line ${LINENO}.${NC}"
echo -e "${YELLOW}Check the error above.${NC}"
' ERR

# ============================================================
# START
# ============================================================

clear

echo -e "${CYAN}${ASCII_ART}${NC}"
echo ""
echo -e "${WHITE}${BOLD}Automatic Draco V4 Installer${NC}"
echo -e "${GRAY}Repository:${NC} ${REPO_URL}"
echo ""

# ============================================================
# ROOT
# ============================================================

section "ROOT ACCESS"

if [ "$EUID" -ne 0 ]; then
    fail "Run this installer as root."
fi

success "Root access confirmed."

# ============================================================
# PANEL NAME
# ============================================================

section "PANEL CONFIGURATION"

echo ""
echo -e "${CYAN}Choose a PM2 process name for your panel.${NC}"
echo ""
echo -e "${GRAY}Examples:${NC}"
echo "  draco-panel"
echo "  suprial-panel"
echo "  game-panel"
echo "  panel"
echo ""

while true; do

    read -rp "$(echo -e "${YELLOW}PM2 process name: ${NC}")" PM2_NAME

    PM2_NAME="$(echo "$PM2_NAME" | xargs)"

    if [[ "$PM2_NAME" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        break
    fi

    error "Invalid name."
    echo -e "${GRAY}Use only letters, numbers, -, _ or .${NC}"

done

success "PM2 name: ${PM2_NAME}"

# ============================================================
# SYSTEM
# ============================================================

section "SYSTEM PREPARATION"

export DEBIAN_FRONTEND=noninteractive

info "Updating package lists..."

apt-get update -y

info "Installing dependencies..."

apt-get install -y \
    curl \
    git \
    ca-certificates \
    gnupg \
    unzip \
    zip \
    build-essential \
    python3 \
    make \
    g++

success "System dependencies installed."

# ============================================================
# NODE.JS
# ============================================================

section "NODE.JS ${NODE_MAJOR}"

CURRENT_NODE=""

if command -v node >/dev/null 2>&1; then
    CURRENT_NODE="$(node -v | sed 's/^v//' | cut -d. -f1)"
fi

if [ "$CURRENT_NODE" != "$NODE_MAJOR" ]; then

    info "Installing Node.js ${NODE_MAJOR}..."

    curl -fsSL \
        "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" |
        bash -

    apt-get install -y nodejs

else

    success "Node.js ${NODE_MAJOR} already installed."

fi

echo ""
echo -e "${GREEN}Node.js:${NC} $(node -v)"
echo -e "${GREEN}NPM:${NC}     $(npm -v)"

# ============================================================
# INSTALL DIRECTORY
# ============================================================

section "PREPARING PANEL DIRECTORY"

mkdir -p /opt

if [ -d "$INSTALL_DIR" ]; then

    BACKUP_DIR="/opt/draco-panel-backup-$(date +%Y%m%d-%H%M%S)"

    warning "Existing Draco installation detected."
    info "Creating backup:"
    echo "  $BACKUP_DIR"

    mv "$INSTALL_DIR" "$BACKUP_DIR"

    success "Old installation backed up."

fi

# ============================================================
# CLONE
# ============================================================

section "CLONING DRACO PANEL"

info "Repository:"
echo "  $REPO_URL"
echo ""

git clone "$REPO_URL" "$INSTALL_DIR"

success "Repository cloned."

# ============================================================
# FIND PANEL ZIP
# ============================================================

section "LOCATING PANEL PACKAGE"

cd "$INSTALL_DIR"

PANEL_ZIP=""

if [ -f "panel.zip" ]; then

    PANEL_ZIP="panel.zip"

else

    PANEL_ZIP="$(
        find . \
            -maxdepth 3 \
            -type f \
            -iname 'panel.zip' |
        head -n 1 ||
        true
    )"

fi

if [ -z "$PANEL_ZIP" ]; then
    fail "panel.zip was not found."
fi

success "Found panel.zip:"
echo "  $PANEL_ZIP"

# ============================================================
# EXTRACT
# ============================================================

section "EXTRACTING PANEL"

info "Extracting panel.zip..."

unzip -o "$PANEL_ZIP"

success "Panel archive extracted."

# ============================================================
# FIND PANEL DIRECTORY
# ============================================================

section "LOCATING PANEL DIRECTORY"

if [ -d "$INSTALL_DIR/panel" ]; then

    PANEL_PATH="$INSTALL_DIR/panel"

else

    PANEL_PATH="$(
        find "$INSTALL_DIR" \
            -maxdepth 3 \
            -type d \
            -name "panel" |
        head -n 1 ||
        true
    )"

fi

if [ -z "$PANEL_PATH" ] || [ ! -d "$PANEL_PATH" ]; then
    fail "Panel directory was not found after extraction."
fi

cd "$PANEL_PATH"

success "Panel directory:"
echo "  $PANEL_PATH"

# ============================================================
# PACKAGE CHECK
# ============================================================

section "VERIFYING PANEL"

if [ ! -f "package.json" ]; then
    fail "package.json was not found."
fi

success "package.json found."

# ============================================================
# NPM INSTALL
# ============================================================

section "INSTALLING NPM PACKAGES"

info "Running npm install..."

npm install

success "NPM packages installed."

# ============================================================
# DATABASE
# ============================================================

section "DATABASE SETUP"

if npm run 2>/dev/null | grep -q "seed"; then

    info "Running database seed..."

    npm run seed

    success "Database seeded."

else

    warning "npm run seed is unavailable."
    warning "Skipping seed step."

fi

# ============================================================
# CREATE USER
# ============================================================

section "PANEL USER"

if npm run 2>/dev/null | grep -q "createUser"; then

    echo ""
    echo -e "${YELLOW}Panel user creation wizard is starting.${NC}"
    echo -e "${GRAY}Enter your administrator details.${NC}"
    echo ""

    npm run createUser

    success "Panel user setup completed."

else

    warning "createUser script was not found."
    warning "Skipping user creation."

fi

# ============================================================
# PM2
# ============================================================

section "PM2 PROCESS MANAGER"

if command -v pm2 >/dev/null 2>&1; then

    success "PM2 already installed."

else

    info "Installing latest PM2..."

    npm install pm2@latest -g

    success "PM2 installed."

fi

echo ""
echo -e "${GREEN}PM2 Version:${NC} $(pm2 -v)"

# ============================================================
# REMOVE OLD PROCESS
# ============================================================

section "PREPARING PM2"

pm2 delete "$PM2_NAME" 2>/dev/null || true

# ============================================================
# START PANEL
# ============================================================

section "STARTING DRACO PANEL"

cd "$PANEL_PATH"

if [ -f "index.js" ]; then

    info "Starting index.js..."

    pm2 start index.js \
        --name "$PM2_NAME"

elif [ -f "package.json" ]; then

    info "index.js not found."
    info "Trying npm start..."

    pm2 start npm \
        --name "$PM2_NAME" \
        -- start

else

    fail "No index.js or package.json found."

fi

success "Draco panel started."

# ============================================================
# SAVE PM2
# ============================================================

section "SAVING PM2"

pm2 save

success "PM2 process list saved."

# ============================================================
# PM2 AUTOSTART
# ============================================================

section "PM2 AUTO START"

if command -v systemctl >/dev/null 2>&1 &&
   [ -d /run/systemd/system ]; then

    info "Systemd detected."

    STARTUP_OUTPUT="$(
        pm2 startup systemd -u root --hp /root 2>&1 ||
        true
    )"

    echo "$STARTUP_OUTPUT"

    STARTUP_COMMAND="$(
        echo "$STARTUP_OUTPUT" |
        grep -E \
        'sudo .*pm2 startup|env PATH=.*pm2 startup' |
        tail -1 ||
        true
    )"

    if [ -n "$STARTUP_COMMAND" ]; then

        info "Applying PM2 startup configuration..."

        eval "$STARTUP_COMMAND" || true

    fi

    pm2 save

    success "PM2 auto-start configured."

else

    warning "Systemd is not available."
    warning "PM2 startup service skipped."

fi

# ============================================================
# WAIT
# ============================================================

section "VERIFYING PANEL"

info "Waiting for panel process..."

sleep 5

# ============================================================
# PM2 STATUS
# ============================================================

section "PM2 STATUS"

pm2 status

# ============================================================
# PROCESS CHECK
# ============================================================

echo ""

PM2_PID="$(pm2 pid "$PM2_NAME" 2>/dev/null || true)"

if [[ "$PM2_PID" =~ ^[0-9]+$ ]] &&
   [ "$PM2_PID" != "0" ]; then

    success "Draco panel is running."
    echo -e "${GREEN}PID:${NC} $PM2_PID"

else

    error "Draco panel is NOT running."

    echo ""
    echo -e "${YELLOW}Check logs:${NC}"
    echo "  pm2 logs $PM2_NAME"

fi

# ============================================================
# FINAL
# ============================================================

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}${BOLD}              DRACO V4 READY ✓${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

echo -e "${CYAN}Panel Directory:${NC}"
echo "  $PANEL_PATH"

echo ""

echo -e "${CYAN}PM2 Process:${NC}"
echo "  $PM2_NAME"

echo ""

echo -e "${CYAN}Useful Commands:${NC}"
echo ""
echo "  pm2 status"
echo "  pm2 logs $PM2_NAME"
echo "  pm2 restart $PM2_NAME"
echo "  pm2 stop $PM2_NAME"
echo "  pm2 delete $PM2_NAME"
echo "  pm2 save"

echo ""

if command -v systemctl >/dev/null 2>&1 &&
   [ -d /run/systemd/system ]; then

    echo -e "${GREEN}✓ PM2 startup configured.${NC}"

else

    echo -e "${YELLOW}! Systemd unavailable — startup service skipped.${NC}"

fi

echo ""
echo -e "${GREEN}Installation completed.${NC}"
echo -e "${CYAN}Suprial Hosting Infrastructure${NC}"
echo ""
